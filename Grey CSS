:root {
  color-scheme: dark;
  --bg: #0e181d;
  --panel: rgba(22, 37, 44, 0.9);
  --ink: #e4ecef;
  --muted: #a8bac1;
  --line: rgba(193, 216, 225, 0.2);
  --ok: #3fcb9f;
  --okbg: #12392f;
  --bad: #f0806e;
  --badbg: #3e1d18;
  --c1: #3fcb9f;
  --c2: #6fa2f5;
  --c3: #b88bef;
  --c4: #f0a25a;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: var(--bg);
  scroll-padding-top: env(safe-area-inset-top, 0px);
}

body {
  min-height: 100vh;
  min-height: 100svh;
  margin: 0;
  isolation: isolate;
  background: transparent;
  color: var(--ink);
  font: 400 16px/1.6 "IBM Plex Sans", system-ui, sans-serif;
}

.background-video {
  position: fixed;
  z-index: -2;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
}

body::before {
  position: fixed;
  z-index: -1;
  inset: 0;
  background: linear-gradient(145deg, rgba(8, 17, 22, 0.76), rgba(10, 20, 25, 0.62));
  content: "";
  pointer-events: none;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: "Bricolage Grotesque", "IBM Plex Sans", sans-serif;
  line-height: 1.15;
}

button,
select {
  font: inherit;
}

button {
  color: inherit;
  cursor: pointer;
}

:focus-visible {
  outline: 3px solid var(--c2);
  outline-offset: 3px;
}

.wrap {
  position: relative;
  width: min(100%, 860px);
  margin: 0 auto;
  padding: calc(28px + env(safe-area-inset-top, 0px)) 20px calc(64px + env(safe-area-inset-bottom, 0px));
}

header {
  margin-bottom: 26px;
}

header h1 {
  font-size: clamp(2rem, 6vw, 3.25rem);
  font-weight: 800;
  letter-spacing: -0.035em;
  text-wrap: balance;
}

header p {
  max-width: 52ch;
  margin: 8px 0 0;
  color: var(--muted);
}

nav {
  display: flex;
  gap: 5px;
  margin-bottom: 20px;
  padding: 5px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

nav button {
  flex: 1;
  min-width: 0;
  padding: 10px 12px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  font-weight: 600;
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}

nav button:hover {
  color: var(--ink);
}

nav button:active {
  transform: scale(0.98);
}

nav button[aria-selected="true"] {
  background: var(--ink);
  color: var(--bg);
}

#cocnav {
  margin-bottom: 10px;
}

#cocnav button {
  border-bottom: 3px solid transparent;
}

#cocnav button[aria-selected="true"] {
  border-bottom-color: var(--col);
  background: color-mix(in srgb, var(--col) 18%, transparent);
  color: var(--ink);
}


.panel {
  padding: clamp(18px, 4vw, 26px);
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.coc {
  margin-bottom: 18px;
  padding: clamp(16px, 4vw, 22px);
  border: 1px solid var(--line);
  border-left: 5px solid var(--col);
  border-radius: 5px 15px 15px 5px;
  background: transparent;
}

.coc h2 {
  color: var(--col);
  font-size: clamp(1.3rem, 4vw, 1.6rem);
  text-wrap: balance;
}

.coc .sub {
  margin: 6px 0 14px;
  color: var(--muted);
}

.note-section { padding: 14px 0 8px; border-top: 1px solid var(--line); } .note-section h3 { margin: 0 0 8px; font-size: 1.05rem; font-weight: 600; } .note-section ul { margin: 0 0 2px; padding-left: 22px; } .note-section li { margin: 5px 0; padding-left: 2px; }

.k{font-weight:600}.setup h2{margin-bottom:8px;font-size:1.6rem}.setup label{display:block;margin:18px 0 8px;font-weight:600}select{max-width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--ink)}.btn{margin-top:20px;padding:11px 20px;border:1px solid transparent;border-radius:10px;background:var(--ink);color:var(--bg);font-weight:600;transition:transform 160ms ease,opacity 160ms ease}.btn:hover{opacity:.9}

.btn:active {
  transform: scale(0.98);
}

.btn.alt {
  margin-left: 8px;
  border-color: var(--line);
  background: transparent;
  color: var(--ink);
}

.best {
  margin-top: 14px;
  color: var(--muted);
  font-size: 0.92rem;
}

.bar {
  height: 8px;
  margin-bottom: 16px;
  overflow: hidden;
  border-radius: 99px;
  background: var(--line);
}

.bar i {
  display: block;
  height: 100%;
  background: var(--col, var(--c1));
  transition: width 250ms ease;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
  color: var(--muted);
  font-size: 0.92rem;
}

.tag {
  color: var(--col);
  font-weight: 600;
}

.q {
  margin: 8px 0 18px;
  font-family: "Bricolage Grotesque", sans-serif;
  font-size: clamp(1.15rem, 4vw, 1.4rem);
  font-weight: 600;
}

.opt {
  display: flex;
  gap: 12px;
  width: 100%;
  margin-bottom: 10px;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: rgba(14, 24, 29, 0.72);
  text-align: left;
  transition: border-color 150ms ease, background-color 150ms ease;
}

.opt:hover:not(:disabled) {
  border-color: var(--ink);
}

.opt b {
  min-width: 1.4em;
}

.opt.right {
  border-color: var(--ok);
  background: var(--okbg);
}

.opt.wrong {
  border-color: var(--bad);
  background: var(--badbg);
}

.opt:disabled {
  cursor: default;
}

.exp {
  margin-top: 14px;
  padding: 13px 15px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: rgba(14, 24, 29, 0.72);
}

.score {
  font-family: "Bricolage Grotesque", sans-serif;
  font-size: clamp(3rem, 12vw, 3.8rem);
  font-weight: 800;
  line-height: 1;
}

.brk {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  margin: 18px 0;
}

.brk div {
  padding: 9px 12px;
  border-left: 4px solid var(--col);
  border-radius: 4px 9px 9px 4px;
  background: rgba(14, 24, 29, 0.72);
}

.quiz-review-item {
  margin-top: 10px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: rgba(14, 24, 29, 0.48);
}
.quiz-review-item summary {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-height: 44px;
  padding: 12px 14px;
  cursor: pointer;
  font-weight: 600;
}
.quiz-review-item summary::marker {
  color: var(--col, var(--c1));
}
.review-index {
  flex: 0 0 auto;
  color: var(--col, var(--c1));
  font-size: 0.82rem;
  font-weight: 600;
  text-transform: uppercase;
}
.quiz-review-content {
  padding: 0 14px 13px;
}
.quiz-review-content p {
  margin: 5px 0;
}
.answer-key {
  color: var(--ok);
  font-weight: 600;
}
.miss-explanation {
  color: var(--muted);
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

