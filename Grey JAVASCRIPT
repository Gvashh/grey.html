const $ = selector => document.querySelector(selector);
const colorFor = id => `var(--c${id})`;
const shuffle = items => {
  const result = [...items];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
};
const store = {
  get(key) {
    try { return JSON.parse(localStorage.getItem(key)); } catch { return null; }
  },
  set(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch { /* storage may be unavailable */ }
  }
};

let scope = 1;
let run = null;
let activeTab = "rev";
function showTab(tab) {
  // Clicking the visible section button hides it; clicking the other switches sections.
  activeTab = activeTab === tab ? null : tab;
  const showReviewer = activeTab === "rev";
  const showQuiz = activeTab === "quiz";
  const reviewer = $("#rev");
  const quiz = $("#quiz");
  reviewer.classList.toggle("hide", !showReviewer);
  reviewer.hidden = !showReviewer;
  quiz.classList.toggle("hide", !showQuiz);
  quiz.hidden = !showQuiz;
  $("#tab-rev").setAttribute("aria-pressed", String(showReviewer));
  $("#tab-quiz").setAttribute("aria-pressed", String(showQuiz));
  if (showQuiz && !run) renderSetup();
}
function renderReviewer() {
  const coc = COCS.find(item => item.id === scope);
  $("#rev").innerHTML = `
    <article class="coc" style="--col:${coc.color}">
      <h2>${coc.title}</h2>
      <p class="sub">${coc.sub}</p>
      <button class="btn alt reviewer-toggle" id="reviewer-toggle" type="button" aria-controls="reviewer-content" aria-expanded="true">Hide reviewer</button>
      <div id="reviewer-content">
        ${coc.notes.map(note => `
          <section class="note-section">
            <h3>${note.h}</h3>
            <ul>${note.l.map(line => `<li>${line}</li>`).join("")}</ul>
          </section>`).join("")}
        <button class="btn quiz-launch" type="button" data-quiz="${coc.id}">Quiz me on COC ${coc.id}<span aria-hidden="true"> →</span></button>
      </div>
    </article>`;
  const reviewerToggle = $("#reviewer-toggle");
  const reviewerContent = $("#reviewer-content");
  reviewerToggle.addEventListener("click", () => {
    const expanded = reviewerToggle.getAttribute("aria-expanded") === "true";
    reviewerToggle.setAttribute("aria-expanded", String(!expanded));
    reviewerContent.hidden = expanded;
    reviewerToggle.textContent = expanded ? "Show reviewer" : "Hide reviewer";
  });
  $(`[data-quiz="${coc.id}"]`).addEventListener("click", () => {
    showTab("quiz");
    renderSetup();
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
}
function renderSetup() { const best = store.get("coc-best") || {}; const questionCount = BANK.filter(question => question.c === scope).length; $("#quiz").innerHTML = `<div class="panel setup" style="--col:${colorFor(scope)}"><p class="tag">COC ${scope} · QUIZ</p><h2>Ready to test yourself?</h2><p class="setup-copy">Take the full ${questionCount}-question quiz. Questions and answer choices are shuffled each time.</p><button class="btn" id="start" type="button">Start quiz <span aria-hidden="true">→</span></button><p class="best">${best[scope] != null ? `Your best score for this COC: ${best[scope]}%` : "No score saved yet — your best score will appear here."}</p></div>`; $("#start").addEventListener("click", () => startQuiz(BANK.filter(question => question.c === scope))); }

function startQuiz(pool) {
  const questions = shuffle(pool).map(question => ({
    ...question,
    choices: shuffle(question.options.map((text, index) => ({ text, correct: index === question.answer })))
  }));
  run = { questions, index: 0, score: 0, answers: [] };
  renderQuestion();
}

function renderQuestion() {
  const question = run.questions[run.index];
  const progress = Math.round((run.index / run.questions.length) * 100);
  $("#quiz").innerHTML = `
    <div class="panel" style="--col:${colorFor(question.c)}">
      <div class="bar" role="progressbar" aria-label="Quiz progress" aria-valuenow="${progress}" aria-valuemin="0" aria-valuemax="100"><i style="width:${progress}%"></i></div>
      <div class="meta"><span class="tag">COC ${question.c}</span><span>Question ${run.index + 1} of ${run.questions.length}</span></div>
      <p class="q">${question.q}</p>
      <div id="opts">${question.choices.map((choice, index) => `<button class="opt" type="button" data-index="${index}"><b>${"ABCD"[index]}.</b><span>${choice.text}</span></button>`).join("")}</div>
      <div id="fb" aria-live="polite"></div>
    </div>`;
  document.querySelectorAll(".opt").forEach(button => {
    button.addEventListener("click", () => answerQuestion(Number(button.dataset.index)));
  });
  $("#opts").addEventListener("keydown", event => {
    const shortcutIndex = "abcd".indexOf(event.key.toLowerCase());
    if (shortcutIndex < 0) return;
    const choiceButton = $(`.opt[data-index="${shortcutIndex}"]`);
    if (choiceButton && !choiceButton.disabled) choiceButton.click();
  });
}
function answerQuestion(selectedIndex) { if (!run || selectedIndex < 0 || selectedIndex > 3 || run.answers.length > run.index) return; const question = run.questions[run.index]; if (!question || !question.choices[selectedIndex]) return; const isCorrect = question.choices[selectedIndex].correct; if (isCorrect) run.score++; run.answers.push({ question, isCorrect }); document.querySelectorAll(".opt").forEach((button, index) => { button.disabled = true; if (question.choices[index].correct) button.classList.add("right"); else if (index === selectedIndex) button.classList.add("wrong"); }); const isLast = run.index === run.questions.length - 1; $("#fb").innerHTML = `<div class="exp" role="status"><b>${isCorrect ? "Correct!" : "Not quite."}</b> ${question.explanation}</div><button class="btn" id="next" type="button">${isLast ? "See results" : "Next question"}<span aria-hidden="true"> →</span></button>`; $("#next").focus(); $("#next").addEventListener("click", () => { if (isLast) renderResults(); else { run.index++; renderQuestion(); } }); }

function renderResults() {
  const total = run.questions.length;
  const percentage = Math.round((run.score / total) * 100);
  const best = store.get("coc-best") || {};
  const isBest = best[scope] == null || percentage > best[scope];
  if (isBest) { best[scope] = percentage; store.set("coc-best", best); }
  const missed = run.answers.filter(answer => !answer.isCorrect);
  const verdict = percentage >= 85
    ? "Excellent work — you are ready for the assessment."
    : percentage >= 70
      ? "Good progress. Review the missed questions and try again."
      : "Keep practicing. Review the notes for the topics you missed.";
  $("#quiz").innerHTML = `
    <div class="panel">
      <p class="tag">COC ${scope} · RESULTS</p>
      <div class="score">${percentage}%</div>
      <p class="result-copy"><b>${run.score} of ${total} correct.</b> ${verdict}${isBest && total >= 5 ? " New personal best!" : ""}</p>
      ${missed.length ? `<h3 class="review-misses">Review your missed questions</h3>${missed.map(({ question }, index) => `
        <details class="quiz-review-item"><summary><span class="review-index">Question ${index + 1}</span>${question.q}</summary><div class="quiz-review-content"><p class="answer-key">Correct answer: ${question.options[question.answer]}</p><p class="miss-explanation">${question.explanation}</p></div></details>`).join("")}` : "<p>Perfect score — nothing to review.</p>"}
      <div class="result-actions">
        ${missed.length ? `<button class="btn" id="retry" type="button">Retry missed (${missed.length})</button>` : ""}
        <button class="btn ${missed.length ? "alt" : ""}" id="again" type="button">New quiz</button>
        <button class="btn alt" id="back-review" type="button">Back to reviewer</button>
      </div>
    </div>`;
  if ($("#retry")) {
    $("#retry").addEventListener("click", () => {
      const missedQuestions = missed.map(item => item.question);
      run = { questions: shuffle(missedQuestions).map(question => ({
        ...question,
        choices: shuffle(question.options.map((text, index) => ({ text, correct: index === question.answer })))
      })), index: 0, score: 0, answers: [] };
      renderQuestion();
    });
  }
  $("#again").addEventListener("click", () => { run = null; renderSetup(); });
  $("#back-review").addEventListener("click", () => showTab("rev"));
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function setCoc(id) {
  scope = id;
  run = null;
  document.documentElement.style.setProperty("--col", colorFor(id));
  document.querySelectorAll("#cocnav button").forEach(button => {
    const selected = Number(button.dataset.coc) === id;
    button.setAttribute("aria-selected", String(selected));
    button.tabIndex = selected ? 0 : -1;
  });
  renderReviewer();
  renderSetup();
}

$("#cocnav").innerHTML = COCS.map(coc => `
  <button role="tab" type="button" data-coc="${coc.id}" aria-selected="false" tabindex="-1" style="--col:${coc.color}">COC ${coc.id}</button>`).join("");
document.querySelectorAll("#cocnav button").forEach(button => {
  button.addEventListener("click", () => setCoc(Number(button.dataset.coc)));
});

$("#tab-rev").addEventListener("click", () => showTab("rev"));
$("#tab-quiz").addEventListener("click", () => showTab("quiz"));

// Let keyboard users move between either set of tabs with the arrow keys.
[...document.querySelectorAll("#cocnav button"), $("#tab-rev"), $("#tab-quiz")].forEach(button => {
  button.addEventListener("keydown", event => {
    if (!["ArrowLeft", "ArrowRight"].includes(event.key)) return;
    const group = button.closest("nav");
    const tabs = [...group.querySelectorAll('[role="tab"]')];
    const currentIndex = tabs.indexOf(button);
    const nextIndex = (currentIndex + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
    tabs[nextIndex].focus();
    tabs[nextIndex].click();
  });
});

setCoc(1);
