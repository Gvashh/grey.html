<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Development Basics</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f5f5;
            color: #fdf9f9;
        }

        /* Navigation */
        .navbar {
            background: #ffffff;
            border-bottom: 1px solid #ddd;
        }

        /* Hero Section */
        .hero {
            min-height: 75vh;
            display: flex;
            align-items: center;
            text-align: center;
            background: #020202;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 5rem);
            font-weight: 700;
            letter-spacing: -3px;
        }

        .hero p {
            max-width: 600px;
            margin: 28px auto;
            color: #666;
            font-size: 1.1rem;
        }

        /* Buttons */
        .btn-dark {
            border-radius: 4px;
            padding: 10px 24px;
        }

        /* Sections */
        .section {
            padding: 80px 0;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 40px;
        }

        /* Tech Cards */
        .tech-card {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 30px;
            height: 100%;
            transition: 0.25s ease;
        }

        .tech-card:hover {
            transform: translateY(-4px);
            border-color: #999;
        }

        .icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #222;
            color: white;
            border-radius: 6px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .tech-card h3 {
            font-size: 1.3rem;
            margin-bottom: 12px;
        }

        .tech-card p {
            color: #666;
            margin: 0;
            line-height: 1.7;
        }

        /* Demo Box */
        .demo-box {
            background: #222;
            color: white;
            padding: 40px;
            border-radius: 8px;
            text-align: center;
        }

        #message {
            margin-top: 20px;
            color: #aaa;
        }

        /* Footer */
        footer {
            background: #222;
            color: #aaa;
            padding: 30px 0;
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">LEON GREY</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#technologies">Technologies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#demo">Demo</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="section hero">
        <div class="container">
            <p class="text-uppercase small fw-bold">Modern Web Development</p>
            <h1>Build smart.<br>Build better.</h1>
            <p>Learn the essential technologies behind modern websites: HTML, CSS, JavaScript, and Bootstrap.</p>
            <a href="#technologies" class="btn btn-dark">Explore</a>
        </div>
    </section>

    <!-- Technologies Section -->
    <section class="section" id="technologies">
        <div class="container">
            <h2 class="section-title text-center">The Essentials</h2>
            <div class="row g-4">

                <!-- HTML -->
                <div class="col-md-6 col-lg-3">
                    <div class="tech-card">
                        <div class="icon">H</div>
                        <h3>HTML</h3>
                        <p>HTML provides the structure of a webpage using elements such as headings, paragraphs, links, images, and sections.</p>
                    </div>
                </div>

                <!-- CSS -->
                <div class="col-md-6 col-lg-3">
                    <div class="tech-card">
                        <div class="icon">C</div>
                        <h3>CSS</h3>
                        <p>CSS controls the appearance of a website, including colors, spacing, typography, layouts, and animations.</p>
                    </div>
                </div>

                <!-- JavaScript -->
                <div class="col-md-6 col-lg-3">
                    <div class="tech-card">
                        <div class="icon">JS</div>
                        <h3>JavaScript</h3>
                        <p>JavaScript adds behavior and interactivity to websites, allowing pages to respond to user actions.</p>
                    </div>
                </div>

                <!-- Bootstrap -->
                <div class="col-md-6 col-lg-3">
                    <div class="tech-card">
                        <div class="icon">B</div>
                        <h3>Bootstrap</h3>
                        <p>Bootstrap provides responsive components and a grid system that makes it easier to build clean interfaces quickly.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- JavaScript Demo -->
    <section class="section" id="demo">
        <div class="container">
            <div class="demo-box">
                <h2>JavaScript Demo</h2>
                <p>Click the button to interact with the page.</p>
                <button class="btn btn-light" onclick="showMessage()">Click Me</button>
                <div id="message"></div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <small>HTML • CSS • JavaScript • Bootstrap</small>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JavaScript -->
    <script>
        function showMessage() {
            const message = document.getElementById("message");
            message.textContent = "Nice! JavaScript is making the page interactive.";
        }
    </script>

</body>
</html>
